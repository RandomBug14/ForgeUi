<Window x:Class="ForgeUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ForgeUI.Converters"
        xmlns:local="clr-namespace:ForgeUI.Views"
        Title="⚒ Skyblock Forge Tracker"
        Width="1050" Height="750"
        MinWidth="700" MinHeight="500"
        Background="#0D0D0D"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ProgressToColorConverter x:Key="ProgressToColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:StringToColorBrushConverter x:Key="StrToColor"/>

        <Style x:Key="MemberCard" TargetType="Border">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SlotCard" TargetType="Border">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="BorderBrush" Value="#2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ForgeProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{Binding ProgressPercent, Converter={StaticResource ProgressToColor}}"
                                        CornerRadius="3" HorizontalAlignment="Left"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#111111"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="16,8">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#0D1829"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#111111" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="⚒  SKYBLOCK FORGE TRACKER" Foreground="#E5E7EB" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Foreground="#6B7280" FontSize="12" Margin="0,3,0,0">
                        <Run Text="Profil : "/>
                        <Run Text="{Binding ProfileName}" Foreground="#60A5FA" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <!-- Barre de recherche -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍 " Foreground="#94A3B8" VerticalAlignment="Center" FontSize="13"/>
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="#E5E7EB"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Width="160"
                                     VerticalAlignment="Center"
                                     CaretBrush="#E5E7EB"
                                     KeyDown="SearchBox_KeyDown"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Rechercher"
                            Style="{StaticResource PrimaryButton}"
                            Click="SearchButton_Click"
                            IsEnabled="{Binding CanRefresh}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TOOLBAR -->
        <Border Grid.Row="1" Background="#0F0F0F" Padding="20,10" BorderBrush="#1F1F1F" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="↻  Actualiser"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding CanRefresh}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⏳ " Foreground="#60A5FA" FontSize="14"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#9CA3AF" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="{Binding LastUpdateDisplay}" Foreground="#6B7280" FontSize="12"/>
                    <TextBlock Text="  •  " Foreground="#374151" FontSize="12"/>
                    <TextBlock Text="{Binding NextRefreshDisplay}" Foreground="#4B5563" FontSize="12"/>
                </StackPanel>

                <Button Grid.Column="2" Content="🔲 Mini barre"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        Click="ToggleMiniBar_Click"/>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <TabControl Grid.Row="2" Background="#0D0D0D" BorderThickness="0" Padding="0">

            <TabItem Header="⚒  Forge">
                <Grid>
                    <Border Margin="20" Padding="16" VerticalAlignment="Top"
                            Background="#1F0A0A" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontSize="13"/>
                    </Border>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasMembers, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center" Foreground="#374151"/>
                        <TextBlock Text="Entrez un pseudo pour charger la forge"
                                   Foreground="#6B7280" FontSize="14" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ScrollViewer Padding="20,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MemberCard}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E5E7EB" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding MemberUuid}" Foreground="#4B5563" FontSize="10" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#0F172A" CornerRadius="20" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Summary}" Foreground="#60A5FA" FontSize="12" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="Aucun item en forge" Foreground="#4B5563" FontStyle="Italic" FontSize="13" Margin="0,4"
                                                       Visibility="{Binding HasNoSlots, Converter={StaticResource BoolToVis}}"/>

                                            <ItemsControl ItemsSource="{Binding Slots}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="220" Style="{StaticResource SlotCard}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock FontSize="11" Foreground="#6B7280">
                                                                        <Run Text="Slot "/>
                                                                        <Run Text="{Binding SlotNumber}" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                                                                    </TextBlock>
                                                                    <Border Grid.Column="1" Padding="5,2"
                                                                            Background="{Binding StatusColor, Converter={StaticResource StrToColor}}"
                                                                            CornerRadius="3" Opacity="0.15"/>
                                                                    <TextBlock Grid.Column="1" Padding="5,2" FontSize="9" FontWeight="Bold"
                                                                               Foreground="{Binding StatusColor, Converter={StaticResource StrToColor}}"
                                                                               Text="{Binding ForgeType}"/>
                                                                </Grid>
                                                                <TextBlock Grid.Row="1" Text="{Binding ItemDisplayName}" Foreground="#E5E7EB" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Row="2" Text="{Binding ItemId}" Foreground="#374151" FontSize="9" Margin="0,1,0,0"/>
                                                                <TextBlock Grid.Row="3" Text="{Binding RemainingDisplay}" Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{Binding StatusColor, Converter={StaticResource StrToColor}}"/>
                                                                <ProgressBar Grid.Row="4" Value="{Binding ProgressPercent}" Maximum="100" Style="{StaticResource ForgeProgress}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="📈  Bazaar">
                <local:BazaarView DataContext="{Binding Bazaar}"/>
            </TabItem>

        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#0A0A0A" Padding="20,8" BorderBrush="#1F1F1F" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#4B5563" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Foreground="#1F2937" FontSize="11" VerticalAlignment="Center">
                    <Run Text="Max 300 req / 5min  •  Refresh auto : "/>
                    <Run Text="{Binding AutoRefreshDisplay, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>