<UserControl x:Class="ForgeUI.Views.BazaarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ForgeUI.Converters"
             Background="#0D0D0D">

    <UserControl.Resources>
        <conv:StringToColorBrushConverter x:Key="StrToColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="📈  BAZAAR — SKELETON KEY"
                               Foreground="#E5E7EB" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding LastUpdate}"
                               Foreground="#4B5563" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#60A5FA" FontSize="12"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                           Text="⏳ Chargement…"/>
            </Grid>

            <!-- Prix des ressources -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="RESSOURCES (prix unitaire insta-buy)" Style="{StaticResource HeaderText}"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mithril Plate  ×1" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding MithrilPlateDisplay}" Style="{StaticResource ValueText}"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Glacite Amalgamation  ×2" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding AmalgamationDisplay}" Style="{StaticResource ValueText}"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Refined Tungsten  ×4" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding RefinedTungstenDisplay}" Style="{StaticResource ValueText}"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Refined Umber  ×4" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding RefinedUmberDisplay}" Style="{StaticResource ValueText}"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Glacite Jewel  ×3" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding GlaciteJewelDisplay}" Style="{StaticResource ValueText}"/>
                    </Grid>

                    <Separator Background="#2A2A2A" Margin="0,10"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Skeleton Key (sell offer)" Foreground="#60A5FA" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SkeletonKeySellDisplay}" Style="{StaticResource ValueText}" Foreground="#60A5FA"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Tableau coût / bénéfice / bénéfice/h -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="COÛT TOTAL &amp; BÉNÉFICE" Style="{StaticResource HeaderText}"/>

                    <!-- En-têtes colonnes -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text=""/>
                        <TextBlock Grid.Column="1" Text="Coût" Foreground="#4B5563" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Bénéfice" Foreground="#4B5563" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Bénéfice/h" Foreground="#4B5563" FontSize="11" HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- ×1 -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="×1 clef" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CostX1}" Style="{StaticResource ValueText}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ProfitX1}"
                                   Foreground="{Binding ProfitColorX1, Converter={StaticResource StrToColor}}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding ProfitPerHourX1}"
                                   Foreground="{Binding ProfitColorX1, Converter={StaticResource StrToColor}}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ×7 -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="×7 clefs (1 personne)" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CostX7}" Style="{StaticResource ValueText}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ProfitX7}"
                                   Foreground="{Binding ProfitColorX7, Converter={StaticResource StrToColor}}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding ProfitPerHourX7}"
                                   Foreground="{Binding ProfitColorX7, Converter={StaticResource StrToColor}}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ×35 -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="×35 clefs (5 personnes)" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CostX35}" Style="{StaticResource ValueText}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ProfitX35}"
                                   Foreground="{Binding ProfitColorX35, Converter={StaticResource StrToColor}}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding ProfitPerHourX35}"
                                   Foreground="{Binding ProfitColorX35, Converter={StaticResource StrToColor}}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>